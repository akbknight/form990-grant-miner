# Copy to .env and fill in the values you actually use.

# Core PostgreSQL warehouse
IRS_DB_DSN=postgresql://postgres:change_me@127.0.0.1:5432/irs990

# Optional Neon warehouse
NEON_DSN=postgresql://user:change_me@your-neon-host/neondb?sslmode=require

# Optional Anthropic access for AI categorization flows
ANTHROPIC_API_KEY=your_api_key_here

# Optional dashboard override if you want the UI to point at a custom SQLite file
FORM990_DASHBOARD_DB=C:\\path\\to\\warehouse.db

